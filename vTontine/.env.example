# ─── Django ──────────────────────────────────────────────────────────────────
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# ─── Base de données ─────────────────────────────────────────────────────────
# Par défaut PostgreSQL. Pour les tests locaux sans Postgres :
#   DB_ENGINE=django.db.backends.sqlite3
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tontine_db
DB_USER=tontine_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433

# ─── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_SERVER_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=tontine-realm
KEYCLOAK_CLIENT_ID=tontine-client
KEYCLOAK_CLIENT_SECRET=change-me
# Compte admin du realm master (création/màj des utilisateurs, reset mot de passe)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL publique utilisée pour construire les liens d'invitation partageables
FRONTEND_URL=https://vtontine.app

# ─── IA (vérification des captures de paiement) ──────────────────────────────
# Clé API Gemini (https://aistudio.google.com/apikey). Laissez vide pour
# désactiver la vérification automatique.
GEMINI_API_KEY=
